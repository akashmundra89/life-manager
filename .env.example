# Copy this file to .env and fill in real values.
# After changing .env you must restart `npm run dev`.

# CricAPI key for the Cricket Scores page.
# Get a free key (100 reqs/day) at https://cricapi.com
VITE_CRICAPI_KEY=

# Supabase project URL and anon key.
# Get these from your Supabase project → Settings → API.
# When set, the app switches to Supabase with per-user auth + real-time sync.
# When absent, the app falls back to localStorage (no login required).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# VAPID public key for Web Push (daily reminders).
# Generate a keypair once with:  npx web-push generate-vapid-keys
# Put the *public* key here; the *private* key goes to Supabase as a secret:
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
